{
  "manifest_version": 3,
  "name": "penny",
  "version": "0.1.0",
  "description": "Tells Amazon shoppers whether to buy now or wait, based on a price-drop forecast.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "sidePanel"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "action": {
    "default_title": "penny",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.amazon.com/*"
      ],
      "js": [
        "content/utils.js",
        "content/extractors/generic.js",
        "content/extractors/amazon.js",
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "simulate-price-drop": {
      "suggested_key": {
        "default": "Alt+Shift+P",
        "mac": "Alt+Shift+P"
      },
      "description": "dev: simulate a price drop for the newest watch (unpacked installs only)"
    }
  }
}
